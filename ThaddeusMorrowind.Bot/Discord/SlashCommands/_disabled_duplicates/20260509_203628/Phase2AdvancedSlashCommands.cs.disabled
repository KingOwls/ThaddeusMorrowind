{
    private readonly IPhase2AdvancedService _service;
    public Phase2CatalogSlashCommands(IPhase2AdvancedService service)=>_service=service;
    [SlashCommand("items","Busca items por término o categoría.")]
    public async Task ItemsAsync(string? termino=null,string? categoria=null){await DeferAsync(); await FollowupAsync(embed:Phase2AdvancedViews.Items(await _service.SearchItemsAsync(termino,categoria)));}
}


