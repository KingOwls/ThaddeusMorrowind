[Group("build", "Estadísticas finales por equipo.")]
public sealed class Phase2BuildSlashCommands : InteractionModuleBase<SocketInteractionContext>
{
    private readonly IPhase2AdvancedService _service;
    public Phase2BuildSlashCommands(IPhase2AdvancedService service)=>_service=service;
    [SlashCommand("stats","Muestra stats finales considerando equipo, artefactos y sets.")]
    public async Task StatsAsync(long personaje_id=0,string? nombre=null){await DeferAsync(); FinalStatsDto? dto=await _service.GetFinalStatsAsync(Context.User.Id,personaje_id>0?(ulong)personaje_id:null,nombre); await FollowupAsync(embed:dto is null?Phase2AdvancedViews.Result("📭 Personaje no encontrado","No encontré ese personaje en tu cuenta.",false):Phase2AdvancedViews.FinalStats(dto));}
}
